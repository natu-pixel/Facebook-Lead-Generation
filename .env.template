# Geoapify API Configuration
GEOAPIFY_API_KEY=your_geoapify_api_key
USE_MOCK_DATA=true

# Targeting Settings
TARGET_COUNTRY=United States
TARGET_CITIES=Charlotte,Columbus,Indianapolis,Nashville,Tampa
TARGET_CATEGORY=restaurant

# Lead Qualification Criteria
MIN_REVIEWS=20
MIN_RATING=4.0
REQUIRE_WEBSITE=false   # false = leads must NOT have a website
REQUIRE_PHONE=true      # true = leads must have a phone number

# Notification Configuration
# Options: console, telegram, slack
NOTIFICATION_CHANNEL=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
